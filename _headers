# HTML always revalidates so deploys show up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# JS/CSS filenames carry a content hash (see scripts/build.mjs), so a changed
# file is always a new URL and these can never go stale.
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/shared/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/icons/*
  Cache-Control: public, max-age=86400, must-revalidate
